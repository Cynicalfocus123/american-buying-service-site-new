# Serve the public site only over HTTPS when deployed to Apache/Hostinger.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Never expose directory indexes if a path is requested directly.
Options -Indexes
